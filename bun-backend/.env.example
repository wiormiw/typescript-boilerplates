# Every key apps/api reads, with its default. An empty value counts as unset.

NODE_ENV=development
LOG_LEVEL=info

# Which processes run: api, worker or all.
ROLE=all
PORT=4600
REQUEST_TIMEOUT_MS=10000
# A larger request body is refused with a 413.
MAX_REQUEST_BODY_BYTES=1048576
# A readiness probe of Postgres or Valkey slower than this counts as failed.
HEALTH_CHECK_TIMEOUT_MS=1000
# Added to the connect timeouts to bound startup as a whole.
STARTUP_SLACK_MS=2000
DRAIN_TIMEOUT_MS=10000
PRE_STOP_DELAY_MS=3000
# PRE_STOP_DELAY_MS + DRAIN_TIMEOUT_MS + DB_CLOSE_TIMEOUT_S * 1000 must be shorter than this.
SHUTDOWN_TIMEOUT_MS=20000
# Retry-After, in seconds, on a request cut off by shutdown.
SHUTDOWN_RETRY_AFTER_S=5

# Required, no default: the local compose services. The API logs in as the non-owner role
# starter_api, which `bun run db:migrate` creates from this URL's user and password.
DATABASE_URL=postgres://starter_api:starter_api@127.0.0.1:4632/starter
# The owner, used only by `bun run db:migrate`. The API never reads it.
DATABASE_MIGRATION_URL=postgres://postgres:starter@127.0.0.1:4632/starter
# How long db:migrate may run as a whole.
MIGRATION_TIMEOUT_MS=60000
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_S=30
DB_CONNECT_TIMEOUT_S=5
DB_CLOSE_TIMEOUT_S=5
DB_MAX_LIFETIME_S=1800
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
DB_SLOW_QUERY_MS=200

# Required, no default.
VALKEY_URL=redis://127.0.0.1:4679
VALKEY_CONNECT_TIMEOUT_MS=2000

OTEL_SERVICE_NAME=starter-api
# grpc | http/protobuf | http/json; grpc goes to 4617, the HTTP flavours to 4618
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4617
OTEL_METRIC_INTERVAL_MS=15000
# off | metrics | metrics+als | traces-sampled | traces-full
OBSERVABILITY_LEVEL=traces-sampled
TRACE_SAMPLE_RATIO=0.1

# Signs sessions and tokens, at least 32 characters, no default: openssl rand -base64 32
AUTH_SECRET=
# The origin clients reach the API at: verification links and OAuth callbacks are built on it.
AUTH_BASE_URL=http://127.0.0.1:4600
# Registration is closed unless this is true (it also stops Google from creating users).
SIGNUP_ENABLED=false
# Google sign-in turns on when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated: where a native sign-in may send the browser back to.
NATIVE_REDIRECT_URIS=starter://auth/callback
# log writes mail to the log (refused when NODE_ENV=production).
# A native sign-in's trip to Google, and the one-time code that ends it.
NATIVE_FLOW_TTL_S=600
NATIVE_CODE_TTL_S=60
# Sign-in and sign-up attempts per client address: a burst of MAX, refilled over the window.
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_S=60
# A rate-limit decision slower than this lets the request through.
RATE_LIMIT_TIMEOUT_MS=500
MAIL_TRANSPORT=log

# Mounts /_debug routes. Never in production.
DEBUG_ROUTES=false
